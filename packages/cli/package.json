{
  "name": "@uploadx-sdk/cli",
  "version": "0.1.2",
  "description": "Command line interface for UploadX — manage apps, tokens and files from your terminal",
  "license": "MIT",
  "author": "Ignacio",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crafter-station/uploadx.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/crafter-station/uploadx#readme",
  "bugs": {
    "url": "https://github.com/crafter-station/uploadx/issues"
  },
  "bin": {
    "uploadx": "./dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "bun test",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "keywords": ["uploadx", "cli", "file-upload", "minio", "s3"]
}
